# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# AWS Cognito Configuration
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_your-user-pool-id

# AWS Configuration (for other AWS services)
# Option 1: Use AWS CLI credentials (recommended)
AWS_REGION=us-east-1
# (AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY will be read from ~/.aws/credentials)

# Option 2: Explicit credentials (less secure)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Demo Authentication Credentials (for development only)
# These should be moved to a secure environment in production
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=DemoPass123!
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPass123! 