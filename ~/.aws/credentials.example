[default]
aws_access_key_id = YOUR_ACCESS_KEY_ID
aws_secret_access_key = YOUR_SECRET_ACCESS_KEY

# You can also create multiple profiles
[production]
aws_access_key_id = YOUR_PRODUCTION_ACCESS_KEY_ID
aws_secret_access_key = YOUR_PRODUCTION_SECRET_ACCESS_KEY

[development]
aws_access_key_id = YOUR_DEV_ACCESS_KEY_ID
aws_secret_access_key = YOUR_DEV_SECRET_ACCESS_KEY 